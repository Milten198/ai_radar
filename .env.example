# Copy to .env and fill in. Never commit .env.

# --- OpenRouter (LLM) ---
OPENROUTER_API_KEY=
# Cheap model for per-article summaries
OPENROUTER_MODEL_SUMMARY=google/gemini-2.5-flash
# Model that writes the daily brief (can be stronger)
OPENROUTER_MODEL_BRIEF=google/gemini-2.5-flash

# --- Supabase (pipeline, server-side only) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key bypasses RLS. Pipeline only. NEVER expose to the dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (dashboard, public) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Pipeline tuning ---
# How far back to fetch on each run (hours)
FETCH_WINDOW_HOURS=48
# Max characters of article text sent to the summarizer
MAX_ARTICLE_CHARS=12000
